{
  "name": "@verse-bot/postgres",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Valentin <https://github.com/vdistortion>",
  "description": "Database client, user and command log repositories for Verse Bot Framework",
  "homepage": "https://verse-bot.zvalentin.com",
  "bugs": {
    "url": "https://github.com/vdistortion/verse-bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vdistortion/verse-bot.git",
    "directory": "packages/postgres"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && npm run copy-migrations",
    "prepack": "cp ../../LICENSE dist/LICENSE",
    "copy-migrations": "node scripts/copy-migrations.mjs",
    "dev": "tsc --watch",
    "lint": "tsc --noemit"
  },
  "dependencies": {
    "@verse-bot/core": "^0.1.0",
    "pg": "^8.23.0",
    "postgrator": "^8.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
